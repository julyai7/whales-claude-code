{
  "description": "Whales capture — observes design work the MCP tools structurally cannot see",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "SessionStart"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__(whales|ask_whales|record_reaction|get_design_profile|search_design_history|submit_design|record_critique|record_approval|universal_critique|list_design_systems|get_design_system|register_design_system|generate_design_system|extract_figma|product_context|self_critique)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "PreToolUse"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "UserPromptSubmit"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "PostToolUse"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "PreCompact"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "Stop"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/whales_hook.py",
            "args": ["--event", "SessionEnd"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
